<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="@dimen/gutter"
        android:paddingEnd="@dimen/page_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:text="@string/playlists"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/presetsHeader"
            style="@style/SectionHeader"
            android:text="@string/presets" />

        <!-- 4 готовых плейлиста — карточки заполняются из кода -->
        <LinearLayout
            android:id="@+id/presets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/ownHeader"
            style="@style/SectionHeader"
            android:text="@string/own_playlist" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/addUrl"
                style="@style/SideButton"
                android:layout_height="56dp"
                android:drawableStart="@drawable/ic_link"
                android:text="@string/add_by_url"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/addFile"
                style="@style/SideButton"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:drawableStart="@drawable/ic_file"
                android:text="@string/add_from_file"
                android:textSize="17sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="6dp"
            android:paddingStart="12dp"
            android:text="@string/playlists_hint"
            android:textColor="@color/text_3"
            android:textSize="14sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/gutter"
            android:scrollbars="none" />
    </LinearLayout>

    <!-- Индикатор загрузки поверх экрана -->
    <LinearLayout
        android:id="@+id/busy"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/loading_playlist"
            android:textColor="@color/text"
            android:textSize="18sp" />
    </LinearLayout>
</FrameLayout>
